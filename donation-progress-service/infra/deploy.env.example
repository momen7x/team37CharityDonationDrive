# Copy to infra/deploy.env (git-ignored) and fill in. These values become the Lambda's environment variables.
# Use the SAME TOKEN_SECRET in all three services. Make it long and random, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Websites allowed to call the API from a browser: the Floci S3 site and the local dev server.
CORS_ORIGINS=http://localhost:4566,http://localhost:8080
RATE_LIMIT_CONFIRM_MAX=30
