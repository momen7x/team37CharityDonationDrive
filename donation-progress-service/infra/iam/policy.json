{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnTablesOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Scan",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/CharityDonations"
      ]
    },
    {
      "Sid": "CallOnlyTheServicesWeNeed",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:000000000000:function:charity-campaign-api",
        "arn:aws:lambda:us-east-1:000000000000:function:charity-pledge-api"
      ]
    },
    {
      "Sid": "ReadOnlyTheEmailApiKey",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:charity/resend-api-key-*"
      ]
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
