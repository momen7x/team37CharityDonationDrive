# Copy to .env for `npm run dev`. .env is git-ignored: never commit it.
PORT=3002

# DEV ONLY value. All three services must use the SAME secret so they accept each other's tokens.
# On Floci/AWS use a long random value instead (see infra/deploy.env.example).
TOKEN_SECRET=dev-only-secret-change-me-0123456789abcdef

# Websites allowed to call this API from a browser (exact origins, comma separated).
CORS_ORIGINS=http://localhost:8080

# Where the other services are when running on your PC (npm run dev).
CAMPAIGN_SERVICE_URL=http://localhost:3001
DONATION_SERVICE_URL=http://localhost:3003

# Business rules
PLEDGE_TTL_DAYS=7
MAX_ACTIVE_PLEDGES=20

# Leave empty to use in-memory data. Set it to use DynamoDB (Floci), see README.
PLEDGES_TABLE=
